# Copia este archivo como ".env" y ajusta los valores. Nunca subas .env a GitHub.

# Genera una clave propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Esta clave también firma los tokens JWT de la API.
SECRET_KEY=cambia-esta-clave-por-una-nueva

# True solo en desarrollo local. Con False se exige SECRET_KEY y HTTPS.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Credenciales del usuario de prueba que crea "python manage.py seed_data"
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin1234
